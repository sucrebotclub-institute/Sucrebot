/* ══════════════════════════════════════════════════════════════
   FIX DEFINITIVO PARA SCROLL HORIZONTAL EN MÓVIL
   Archivo: /shared/css/mobile-fix.css
   ══════════════════════════════════════════════════════════════ */

@media (max-width: 768px) {
  /* Fix nuclear para html y body */
  html {
    max-width: 100vw !important;
    overflow-x: hidden !important;
    position: relative !important;
  }
  
  body {
    max-width: 100vw !important;
    overflow-x: hidden !important;
    position: relative !important;
  }
  
  /* Todos los elementos respetan el viewport */
  body * {
    max-width: 100vw !important;
    box-sizing: border-box !important;
  }
  
  /* Contenedores principales */
  .sticky-header,
  .top-bar,
  header,
  nav {
    max-width: 100vw !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow-x: hidden !important;
  }
  
  /* Fix específico para el botón de Google Sign-In */
  #btnLogin {
    max-width: 140px !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }
  
  #btnLogin > div {
    max-width: 140px !important;
    overflow: hidden !important;
  }
  
  #btnLogin iframe {
    max-width: 140px !important;
    width: 140px !important;
    overflow: hidden !important;
  }
  
  /* Fix para información de usuario */
  .user-info {
    max-width: 140px !important;
    overflow: hidden !important;
    flex-shrink: 0 !important;
  }
  
  .user-avatar {
    width: 18px !important;
    height: 18px !important;
    flex-shrink: 0 !important;
  }
  
  .user-name {
    max-width: 60px !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    font-size: 8px !important;
    flex-shrink: 1 !important;
  }
  
  .btn-logout {
    font-size: 8px !important;
    padding: 2px 4px !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
  }
  
  /* Top bar ajustes adicionales */
  .top-bar {
    padding: 8px 10px !important;
    gap: 8px !important;
  }
  
  .top-bar a {
    flex-shrink: 0 !important;
  }
  
  /* Prevenir desbordamiento de cualquier iframe */
  iframe {
    max-width: 100% !important;
  }
}
