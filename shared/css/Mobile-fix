/* ══════════════════════════════════════════════════════════════
   FIX DEFINITIVO PARA MÓVIL - TODAS LAS CORRECCIONES
   Archivo: /shared/css/mobile-fix.css
   ══════════════════════════════════════════════════════════════ */

@media (max-width: 768px) {
  /* ── FIX 0: PADDING DEL BODY PARA QUE NO TAPE EL HEADER ── */
  body {
    padding-top: 180px !important;
  }
  
  /* ── FIX 1: OVERFLOW HORIZONTAL ── */
  * { 
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;
  }
  
  html {
    overflow-x: hidden !important;
    width: 100%;
  }
  
  body {
    overflow-x: hidden !important;
    width: 100%;
  }
  
  body * {
    max-width: 100vw !important;
  }
  
  /* ── FIX 2: CONTENEDORES PRINCIPALES ── */
  .sticky-header {
    width: 100% !important;
    overflow: hidden !important;
    z-index: 1000 !important;
  }
  
  .top-bar {
    width: 100% !important;
    max-width: 100vw !important;
    box-sizing: border-box !important;
  }
  
  header {
    width: 100% !important;
    max-width: 100vw !important;
    overflow: hidden !important;
  }
  
  nav {
    width: 100% !important;
    max-width: 100vw !important;
    position: relative !important;
    z-index: 100 !important;
  }
  
  /* ── FIX 3: BOTÓN DE GOOGLE Y USUARIO ── */
  #btnLogin,
  #btnLogin > div,
  #btnLogin iframe {
    max-width: 110px !important;
    overflow: hidden !important;
  }
  
  .user-info {
    max-width: 130px !important;
    overflow: hidden !important;
    flex-shrink: 0 !important;
  }
  
  .user-name {
    max-width: 50px !important;
    font-size: 7px !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }
  
  .btn-logout {
    font-size: 7px !important;
    padding: 2px 4px !important;
  }
  
  /* ── FIX 4: DROPDOWN QUE SALGA DEBAJO DEL NAV ── */
  .dropdown-menu {
    position: fixed !important;
    top: auto !important;
    bottom: auto !important;
    margin-top: 0 !important;
    /* JavaScript calculará la posición correcta */
    z-index: 999 !important;
  }
  
  /* ── FIX 5: PREVENIR IFRAMES DESBORDADOS ── */
  iframe {
    max-width: 100% !important;
  }
}
